        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum(increase(githubsts_token_exchanges_total{namespace=~\"$namespace\",job=~\"$job\",github_app=~\"$app\",identity=~\"$identity\",result=\"success\"}[$__range])) or on() (0 * count(githubsts_token_exchanges_total{namespace=~\"$namespace\",job=~\"$job\",github_app=~\"$app\",identity=~\"$identity\"}))",
          "legendFormat": "successes",
          "range": true,
